# ========================================
# ⚠️ セキュリティ重要事項 ⚠️
# ========================================
# 1. このファイルをコピーして .env.local を作成してください
# 2. 実際のProject IDを .env.local に設定してください  
# 3. .env.local は .gitignore により自動的に除外されます
# 4. 本番環境ではVercelの環境変数機能を使用してください

# ========================================
# WalletConnect設定
# ========================================
# WalletConnect Project ID を取得：
# 1. https://dashboard.reown.com/sign-in にアクセス
# 2. プロジェクトを作成
# 3. Project ID をコピーして .env.local に貼り付け
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ========================================
# ネットワーク設定
# ========================================
# アプリケーションの実行環境
NEXT_PUBLIC_ENVIRONMENT=development

# デフォルトネットワーク
# 利用可能な値 (JPYC対応ネットワークのみ):
#   - ethereum (Ethereum Mainnet - JPYC対応)
#   - sepolia (Ethereum Sepolia Testnet - JPYC対応)
#   - polygon (Polygon Mainnet - JPYC対応)
#   - polygon-amoy (Polygon Amoy Testnet - 開発用)
#   - arbitrum (Arbitrum One Mainnet - JPYC対応)
#   - arbitrum-sepolia (Arbitrum Sepolia Testnet - 開発用)
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia

# ========================================
# JPYC コントラクト設定
# ========================================
# 📍 正式なJPYCコントラクトアドレス（全ネットワーク統一）
NEXT_PUBLIC_JPYC_CONTRACT_ETHEREUM=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
NEXT_PUBLIC_JPYC_CONTRACT_POLYGON=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
NEXT_PUBLIC_JPYC_CONTRACT_AVALANCHE=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29

# 🧪 Sepoliaテストネット（Faucetの関係で複数）
NEXT_PUBLIC_JPYC_CONTRACT_SEPOLIA_FAUCET=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BDB
NEXT_PUBLIC_JPYC_CONTRACT_SEPOLIA_COMMUNITY=0xd3eF95d29A198868241FE374A999fc25F6152253

# 🧪 その他テストネット（正式アドレス）
NEXT_PUBLIC_JPYC_CONTRACT_POLYGON_AMOY=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
NEXT_PUBLIC_JPYC_CONTRACT_AVALANCHE_FUJI=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29

# 🔬 テスト用・廃止予定アドレス（後方互換性のため残存）
# NEXT_PUBLIC_JPYC_TEST_CONTRACT_1=0xd3eF95d29A198868241FE374A999fc25F6152253
# NEXT_PUBLIC_JPYC_TEST_CONTRACT_2=0x6AE7DFC73E0dBE1470B055B7195c7e43291ca811

# 🚫 廃止予定（後方互換性のため残存）
NEXT_PUBLIC_JPYC_CONTRACT_ARBITRUM=0x0000000000000000000000000000000000000000

# ========================================
# アプリケーション設定
# ========================================
NEXT_PUBLIC_APP_NAME=SBT-JPYC-QR-Scanner
NEXT_PUBLIC_APP_DESCRIPTION=SBT表示とネットワーク検証機能付きJPYC決済アプリ

# ========================================
# ホストネットワーク設定
# ========================================
# スマートフォンからのアクセスを許可（ローカル開発用）
HOSTNAME=0.0.0.0

# ========================================
# ブロックチェーンRPC設定（オプション）
# ========================================
# JPYC対応ネットワークのみ

# Ethereumメインネット
NEXT_PUBLIC_ETH_RPC_URL=https://eth.public-rpc.com

# Sepoliaテストネット
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/

# Polygon Mainnet
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Amoy Testnet
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Arbitrum
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
