# ========================================
# WalletConnect設定
# ========================================
# WalletConnect Project ID を取得：
# 1. https://dashboard.reown.com/sign-in にアクセス
# 2. プロジェクトを作成
# 3. Project ID をコピーして以下に貼り付け
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ========================================
# ネットワーク設定
# ========================================
# アプリケーションの実行環境
NEXT_PUBLIC_ENVIRONMENT=development

# デフォルトネットワーク
# 利用可能な値:
#   - ethereum (Ethereum Mainnet)
#   - sepolia (Ethereum Sepolia Testnet)
#   - polygon (Polygon Mainnet)
#   - polygon-mumbai (Polygon Mumbai Testnet)
#   - arbitrum (Arbitrum One Mainnet)
#   - arbitrum-sepolia (Arbitrum Sepolia Testnet)
#   - optimism (Optimism Mainnet)
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia

# ========================================
# JPYC コントラクト設定
# ========================================
# ⭐ Ethereum Sepolia テストネット
NEXT_PUBLIC_JPYC_CONTRACT_ADDRESS=0xd3eF95d29A198868241FE374A999fc25F6152253
NEXT_PUBLIC_CHAIN_ID=11155111

# Polygon Mainnet JPYC (任意設定)
# NEXT_PUBLIC_JPYC_POLYGON_ADDRESS=0x6AE7DFC73E0dBE1470B055B7195c7e43291ca811

# Arbitrum One Mainnet JPYC (任意設定)
# NEXT_PUBLIC_JPYC_ARBITRUM_ADDRESS=0x0000000000000000000000000000000000000000

# ========================================
# アプリケーション設定
# ========================================
NEXT_PUBLIC_APP_NAME=SBT-JPYC-QR-Scanner
NEXT_PUBLIC_APP_DESCRIPTION=SBT表示とネットワーク検証機能付きJPYC決済アプリ

# ========================================
# ホストネットワーク設定
# ========================================
# スマートフォンからのアクセスを許可（ローカル開発用）
HOSTNAME=0.0.0.0

# ========================================
# ブロックチェーンRPC設定（オプション）
# ========================================
# Ethereumメインネット
NEXT_PUBLIC_ETH_RPC_URL=https://eth.public-rpc.com

# Sepoliaテストネット
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/

# Polygon
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com

# Arbitrum
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optimism
NEXT_PUBLIC_OPTIMISM_RPC_URL=https://mainnet.optimism.io
